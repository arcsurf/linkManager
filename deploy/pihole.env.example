# Integración de linkManager con Pi-hole (opcional).
# El instalador copia este archivo a /etc/linkmanager/pihole.env (solo root lo
# lee; systemd lo carga al iniciar el servicio). Después de editarlo:
#   sudo systemctl restart linkmanager
#
# Si LM_PIHOLE_URL o LM_PIHOLE_PASSWORD quedan vacíos, la integración se desactiva.

# URL base de Pi-hole, sin /admin. Ejemplos: http://192.0.2.10  o  https://pi.hole
LM_PIHOLE_URL=

# Pi-hole v6: la contraseña web o, mejor, una "app password"
#   (Settings > Web interface / API > Configure app password).
# Pi-hole v5: el token de la API (Settings > API > Show API token)
#   o la contraseña web (linkManager calcula el token).
LM_PIHOLE_PASSWORD=

# auto detecta la versión; o forzala con 5 o 6.
LM_PIHOLE_VERSION=auto

# Ponelo en 0 si Pi-hole usa HTTPS con certificado autofirmado.
LM_PIHOLE_VERIFY_TLS=1
